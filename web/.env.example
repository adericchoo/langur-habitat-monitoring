# Frontend environment (Vite). Copy to `.env` for local overrides.
# Only VITE_* vars are exposed to the browser bundle.

# 2025 satellite basemap, served as an XYZ PNG tile pyramid (EPSG:3857, z8-13)
# built with gdal2tiles. In dev these are served from web/public/basemap/tiles.
# In production, host the tiles (any static host / CDN) and point this at the
# template, e.g. https://cdn.example.org/basemap/{z}/{x}/{y}.png
# The tiles are gitignored and never committed.
# Leave unset to use the dev default (/basemap/tiles/{z}/{x}/{y}.png).
VITE_BASEMAP_TILES=/basemap/tiles/{z}/{x}/{y}.png
