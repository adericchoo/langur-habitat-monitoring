# Copy this file to .env and fill in real values. The real .env is git-ignored.

# Google Earth Engine service-account JSON (path to file, or inline JSON)
GEE_SERVICE_ACCOUNT_JSON=

# Cloudflare R2 account ID
R2_ACCOUNT_ID=
# R2 access key ID
R2_ACCESS_KEY_ID=
# R2 secret access key
R2_SECRET_ACCESS_KEY=
# R2 bucket name for published tiles/data
R2_BUCKET=

# Base URL the web frontend fetches map tiles from
VITE_TILES_BASE_URL=
